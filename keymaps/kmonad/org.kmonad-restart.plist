<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>org.kmonad-restart</string>
    <!-- Kill kmonad nightly to reap zombie children left by cmd-button;
         org.kmonad (KeepAlive) restarts it. If the Mac is asleep at 04:00,
        launchd runs this once on wake. Runs as root (LaunchDaemon), no sudo needed. -->
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/pkill</string>
        <string>-x</string>
        <string>kmonad</string>
    </array>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardErrorPath</key>
    <string>/tmp/kmonad-restart.stderr.log</string>
</dict>
</plist>
